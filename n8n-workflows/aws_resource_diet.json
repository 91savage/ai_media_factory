{
  "name": "AWS 비용 도둑 탐지 봇",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "매일 아침 10시",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "http://api-service/aws-waste",
        "options": {}
      },
      "id": "http-get-aws",
      "name": "AWS 상태 스캔",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1/models/gemini-2.5-flash:generateContent",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "여기에_GEMINI_API_키를_붙여넣으세요"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contents",
              "value": "={{ [{ parts: [{ text: `너는 AWS 비용 최적화(FinOps) 전문가야. 다음은 현재 내 AWS 계정에서 돈만 먹고 있는 방치된 자원(고아 EBS 볼륨, 연결 안 된 탄력적 IP) 목록이야. 이 데이터를 분석해서 조치가 필요한 사항들을 한국어로 3~4줄로 짧게 브리핑해줘. 텔레그램으로 보낼 거니까 예쁜 이모지도 써주고, 만약 빈 배열이라서 낭비되는 자원이 없다면 '현재 AWS 계정이 군더더기 없이 완벽하게 관리되고 있습니다! 💸✨' 라고 칭찬해줘. 데이터: ${JSON.stringify($json)}` }] }] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-gemini",
      "name": "Gemini AI 요약",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [640, 300]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.candidates[0].content.parts[0].text }}",
        "additionalFields": {}
      },
      "id": "telegram",
      "name": "Telegram 브리핑",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [860, 300],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot API"
        }
      }
    }
  ],
  "connections": {
    "매일 아침 10시": {
      "main": [
        [
          {
            "node": "AWS 상태 스캔",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AWS 상태 스캔": {
      "main": [
        [
          {
            "node": "Gemini AI 요약",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini AI 요약": {
      "main": [
        [
          {
            "node": "Telegram 브리핑",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}