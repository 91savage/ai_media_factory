{
  "name": "K8s 리소스 다이어트 봇",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "매일 아침 9시",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "http://api-service/k8s-waste",
        "options": {}
      },
      "id": "http-get-k8s",
      "name": "K8s 상태 스캔",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1/models/gemini-2.5-flash:generateContent",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "여기에_GEMINI_API_키를_붙여넣으세요"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contents",
              "value": "={{ [{ parts: [{ text: `너는 시니어 DevOps 엔지니어 봇이야. 다음은 현재 K8s 클러스터의 낭비되는 자원(좀비 파드, 방치된 볼륨 등)을 수집한 JSON 데이터야. 이 데이터를 분석해서 조치가 필요한 사항들을 한국어로 3~4줄로 짧게 요약해줘. 그리고 텔레그램으로 보낼 거니까 예쁜 이모지도 써줘. 만약 낭비되는 자원이 비어있다면 '현재 클러스터가 아주 깨끗하게 유지되고 있습니다! 🌿' 라고 칭찬해줘. 데이터: ${JSON.stringify($json)}` }] }] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-gemini",
      "name": "Gemini AI 요약",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [640, 300]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.candidates[0].content.parts[0].text }}",
        "additionalFields": {}
      },
      "id": "telegram",
      "name": "Telegram 브리핑",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [860, 300],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot API"
        }
      }
    }
  ],
  "connections": {
    "매일 아침 9시": {
      "main": [
        [
          {
            "node": "K8s 상태 스캔",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "K8s 상태 스캔": {
      "main": [
        [
          {
            "node": "Gemini AI 요약",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini AI 요약": {
      "main": [
        [
          {
            "node": "Telegram 브리핑",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}