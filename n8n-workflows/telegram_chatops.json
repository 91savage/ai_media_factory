{
  "name": "AI Media Factory - Telegram ChatOps",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "telegram-trigger-node",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        200,
        200
      ],
      "webhookId": "ai-media-trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://api-service:80/generate-image",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "prompt",
              "value": "={{ $json.message.text }}"
            },
            {
              "name": "chat_id",
              "value": "={{ $json.message.chat.id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-request-node",
      "name": "Call API Server",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        420,
        200
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "=\u23f3 \uc811\uc218 \uc644\ub8cc! 5\ucd08 \ub4a4 \uc774\ubbf8\uc9c0\uac00 \uc644\uc131\ub429\ub2c8\ub2e4.",
        "additionalFields": {}
      },
      "id": "telegram-reply-node",
      "name": "Send Acknowledgment",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        640,
        200
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-media-result",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook (Receive Result)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        400
      ],
      "webhookId": "ai-media-result"
    },
    {
      "parameters": {
        "chatId": "={{ $json.body.chat_id }}",
        "operation": "sendPhoto",
        "file": "data",
        "caption": "=\u2705 [AI Media Factory] \uc791\uc5c5 \uc644\ub8cc\n\nTask ID: {{$json.body.task_id}}\nPrompt: {{$json.body.prompt}}{{ $json.body.error ? '\\n\\n\u274c \uc5d0\ub7ec: ' + $json.body.error : '' }}",
        "additionalFields": {}
      },
      "id": "telegram-result-node",
      "name": "Send Final Image",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        640,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nif (item.json.body.error) {\n  return item;\n}\nitem.binary = {\n  data: {\n    data: item.json.body.image_base64,\n    mimeType: 'image/png',\n    fileName: 'image.png'\n  }\n};\nreturn item;"
      },
      "id": "base64-to-binary",
      "name": "Parse Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        400
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Call API Server",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call API Server": {
      "main": [
        [
          {
            "node": "Send Acknowledgment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook (Receive Result)": {
      "main": [
        [
          {
            "node": "Parse Base64",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Base64": {
      "main": [
        [
          {
            "node": "Send Final Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "chatops-v1-uuid"
}